# Copy this file to .env locally. Never commit your real API key.
GEMINI_API_KEY=replace_with_your_private_key
# Keep model configurable so it can be changed without a code edit.
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated exact frontend origins. Add the deployed GitHub Pages origin later.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://chandravadiyadeep.github.io
MAX_PAPERS_PER_REQUEST=10
MAX_CHARS_PER_PAPER=120000
MAX_TOTAL_CHARS=500000
